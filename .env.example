# Database (required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/debate_arena

# LLM API keys (required for production; at least one of each pair for debates/judges)
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=
# GEMINI_API_KEY=  # alternative to GOOGLE_API_KEY

# Optional: LocalJudge FastAPI service (runs in stub mode if unreachable)
LOCAL_JUDGE_URL=http://localhost:8000

# Optional: override default models
# DIGEST_MODEL=gpt-4o-mini
# JUDGE_1_MODEL=gpt-4o
# JUDGE_2_MODEL=gemini-1.5-flash
